# Telegram
BOT_TOKEN=
ADMIN_ID=

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Postgres (PG_* должны совпадать с environment сервиса postgres_db в docker-compose.yaml)
PG_NAME=finance_bot_db
PG_USER=postgres
PG_PASSWORD=change-me-match-compose
PG_HOST=postgres_db
PG_PORT=5432

# FX (курсы к USD, обновление раз в час)
FX_API_URL=https://api.exchangerate.fun/latest?base=USD
FX_SYNC_INTERVAL_SEC=3600

# OpenAI — категоризация импорта (один запрос на весь файл)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
